# Cognee Cloud (copy from the Connection Details card on the API Keys page)
COGNEE_URL=https://your-tenant.aws.cognee.ai
COGNEE_API_KEY=
COGNEE_TENANT_ID=
COGNEE_DATASET=msc-class

# Cloudflare Workers AI (REST)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Cookie signing secret: any long random string
SESSION_SECRET=change-me

# Optional: override the built-in admin password
# ADMIN_PASSWORD=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://chat.yassh.in/announcements
